# --- Provider -------------------------------------------------------------
# google (free tier, default) | anthropic | openai | ollama (local, no key)
LLM_PROVIDER=google

# Free key, no card required: https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza...

# Optional model override. Default is gemini-flash-latest, which works on
# projects where pinned model names return `limit: 0`.
# GEMINI_MODEL=gemini-flash-latest

# Alternatives
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OLLAMA_BASE_URL=http://localhost:11434

# --- Deployment -----------------------------------------------------------
# true  = header key required, env fallback disabled (Central AI / production)
# false = env fallback allowed (local testing only)
MULTI_TENANT=false

MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=INFO
